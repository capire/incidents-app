    "@cap-js/attachments": "^2",
    "@cap-js/audit-logging": ">=0.8.3",
    "@cap-js/cds-test": "*",
    "@cap-js/change-tracking": "^1.0.6",
    "@cap-js/sqlite": ">=3.1",
    "@huggingface/hub": "^2.15.0",
    "@huggingface/tokenizers": "0.1.3",
    "onnxruntime-node": "1.20.1"
